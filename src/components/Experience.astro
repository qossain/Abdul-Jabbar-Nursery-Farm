---
const awards = [
  { name: 'Fruit Plant Excellence', icon: 'M24 17c-4-4-13-3-14 5-1 8 6 16 10 16 2 0 3-1 4-1s2 1 4 1c4 0 11-8 10-16-1-8-10-9-14-5Zm0 0c0-5 2-8 5-10m-5 6c-4 0-6-2-6-5 4 0 6 1 6 5Z' },
  { name: 'Outstanding Plant Quality', icon: 'M11 35C11 18 21 10 37 10c0 16-8 26-23 25m-3 3c5-8 11-13 20-19m-15 9 1-7m5 2 7-1' },
  { name: 'Ornamental Growing', icon: 'M24 21c-3-7 0-11 3-11 4 0 5 4 3 8 5-5 10-3 10 1 0 3-4 5-9 5 6 2 7 7 4 9-3 2-7 0-10-5 1 6-2 9-5 8-4-1-4-5-1-10-5 3-9 1-9-3 0-3 4-5 10-3-4-4-3-8 0-9 2-1 4 1 5 5Zm0 0a3 3 0 1 0 0 6 3 3 0 0 0 0-6Zm0 6v13' },
  { name: 'Landscape Design', icon: 'M7 35h34M8 31l10-12 8 9 4-5 10 8M28 14a4 4 0 1 0 8 0 4 4 0 0 0-8 0ZM9 39h30' },
  { name: 'Nursery Excellence', icon: 'M24 38V23m0 9-7-7m7 3 7-7M24 8c-4-5-10-1-9 3-6-1-9 6-5 9-3 5 1 9 7 8m7-20c4-5 10-1 9 3 6-1 9 6 5 9 3 5-1 9-7 8M17 39h14' },
];
const leaves = [[37, 46], [31, 57], [28, 69], [28, 81], [31, 93], [36, 104], [44, 114], [54, 122]];
---

<section class="experience" id="story" aria-labelledby="experience-title">
  <div class="section-wrap">
  <div class="experience-heading">
    <h2 id="experience-title">Abdul Jabbar</h2>
    <p>Nursery Farm and Landscaping</p>
    <span>Pattoki, Pakistan</span>
  </div>
  <div class="experience-facts" aria-label="Nursery experience">
    <div><svg viewBox="0 0 32 40" aria-hidden="true"><path d="M16 37V14M16 25C8 25 4 20 4 14c7 0 12 4 12 11Zm0-8C16 8 21 4 28 3c0 8-4 13-12 14Z" /></svg><strong>Since 1978</strong></div>
    <div><svg viewBox="0 0 32 40" aria-hidden="true"><path d="M16 25V8M16 18C9 18 6 14 6 9c6 0 10 3 10 9Zm0-4C16 7 20 4 26 3c0 6-3 10-10 11ZM6 26h20l-3 10H9Z" /></svg><strong>Top distributor in Pakistan</strong></div>
    <div><svg viewBox="0 0 32 40" aria-hidden="true"><path d="M13 37h6l-1-13c6-1 10-5 10-10 0-6-5-10-12-10S4 8 4 14c0 5 4 9 10 10Zm-3 0h12" /></svg><strong>Nursery experience</strong></div>
  </div>
  <div class="recognition">
    <div class="recognition-heading">
      <h3>Awards and recognition</h3>
    </div>
    <div class="award-list">
      {awards.map((award) => (
        <button class="award" type="button" aria-label={award.name} aria-pressed="false" data-award>
          <span class="award-medallion" aria-hidden="true">
            <svg class="award-laurel" viewBox="0 0 160 160" fill="none">
              <g stroke="currentColor" stroke-width="1.4">
                <path d="M79 145 C39 135 22 97 32 42 M81 145 C121 135 138 97 128 42" />
              </g>
              <g fill="currentColor">
                {leaves.map(([x, y]) => <path d="M0 0 C-10 -2 -12 -9 -11 -13 C-4 -12 0 -7 0 0Z" transform={`translate(${x} ${y})`} />)}
                {leaves.map(([x, y]) => <path d="M0 0 C10 -2 12 -9 11 -13 C4 -12 0 -7 0 0Z" transform={`translate(${160 - x} ${y})`} />)}
              </g>
            </svg>
            <svg class="award-symbol" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d={award.icon} /></svg>
          </span>
          <span class="award-name">{award.name}</span>
        </button>
      ))}
    </div>
  </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-award]').forEach((award) => {
    award.addEventListener('click', () => {
      award.setAttribute('aria-pressed', String(award.getAttribute('aria-pressed') !== 'true'));
    });
  });
</script>
