---
const experienceYears = new Date().getUTCFullYear() - 1978;
---

<section class="experience" id="story" aria-labelledby="experience-title">
  <div class="section-wrap">
  <div class="experience-heading">
    <img class="experience-logo" src="/logo.webp" alt="" width="80" height="80" loading="lazy" decoding="async" />
    <h2 id="experience-title">Abdul Jabbar</h2>
    <p>Nursery Farm and Landscaping</p>
    <span>Pattoki, Pakistan</span>
  </div>
  <div class="experience-facts" aria-label="Nursery experience">
    <div><svg viewBox="0 0 32 40" aria-hidden="true"><path d="M16 37V14M16 25C8 25 4 20 4 14c7 0 12 4 12 11Zm0-8C16 8 21 4 28 3c0 8-4 13-12 14Z" /></svg><strong>Since 1978</strong></div>
    <div><svg viewBox="0 0 32 40" aria-hidden="true"><path d="M16 25V8M16 18C9 18 6 14 6 9c6 0 10 3 10 9Zm0-4C16 7 20 4 26 3c0 6-3 10-10 11ZM6 26h20l-3 10H9Z" /></svg><strong>Plants and landscaping in Pattoki</strong></div>
    <div><svg viewBox="0 0 32 40" aria-hidden="true"><path d="M13 37h6l-1-13c6-1 10-5 10-10 0-6-5-10-12-10S4 8 4 14c0 5 4 9 10 10Zm-3 0h12" /></svg><strong data-experience-label aria-label={`${experienceYears} years of nursery experience`}><span data-experience-years>{experienceYears}</span> years of nursery experience</strong></div>
  </div>
  </div>
</section>

<script>
  const years = document.querySelector<HTMLElement>('[data-experience-years]');
  const label = document.querySelector<HTMLElement>('[data-experience-label]');
  if (years && label) {
    const current = new Date().getFullYear() - 1978;
    years.textContent = String(current);
    label.setAttribute('aria-label', `${current} years of nursery experience`);
    if ('IntersectionObserver' in window && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      const observer = new IntersectionObserver(([entry]) => {
        if (!entry.isIntersecting) return;
        observer.disconnect();
        const start = performance.now();
        const animate = (now: number) => {
          const progress = Math.min((now - start) / 900, 1);
          years.textContent = String(Math.round(current * (1 - (1 - progress) ** 3)));
          if (progress < 1) requestAnimationFrame(animate);
        };
        requestAnimationFrame(animate);
      }, { threshold: .5 });
      observer.observe(years);
    }
  }
</script>
