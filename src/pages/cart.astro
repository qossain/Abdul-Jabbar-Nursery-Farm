---
import BaseLayout from '../layouts/BaseLayout.astro';
import { plantsFor } from '../data/catalog';
const validIndoorSlugs = plantsFor('indoor').map((plant) => plant.slug);
---
<BaseLayout title="Cart | Abdul Jabbar Nursery Farm" description="Review your selected plants and enquire with the nursery on WhatsApp." noindex={true}>
  <main id="main" class="cart-page cart-reference" data-valid-indoor-slugs={JSON.stringify(validIndoorSlugs)}>
    <div class="cart-sheet">
      <header class="cart-sheet-header"><h1>Cart</h1></header>
      <div class="cart-sheet-content">
        <div class="cart-products" data-cart-items aria-live="polite"></div>
        <section class="cart-enquiry-summary" data-cart-summary hidden aria-labelledby="cart-summary-title">
          <div class="cart-summary-heading"><div><span class="cart-summary-kicker">YOUR SELECTION</span><h2 id="cart-summary-title">Enquiry summary</h2></div><span class="cart-summary-count" data-cart-summary-count></span></div>
          <div class="cart-summary-row"><span>Plants subtotal</span><strong data-cart-summary-total></strong></div>
          <div class="cart-summary-next"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.5 11.6a8.5 8.5 0 0 1-12.7 7.4L3 20.5l1.5-4.6a8.5 8.5 0 1 1 16-4.3Z"/><path d="M8.5 7.8c.3-.5.6-.5.9-.5h.4l1 2.2-.7.8c.6 1.3 1.6 2.3 2.9 2.9l.8-.7 2.2 1v.4c0 .4-.1.7-.5 1-1.1.7-2.8 0-4.7-1.9S7.8 8.9 8.5 7.8Z"/></svg><p><strong>What happens next?</strong><span>Review your message on WhatsApp. The nursery will confirm availability, prices and delivery with you.</span></p></div>
        </section>
        <div class="cart-browse-area"><p class="cart-single-prompt" data-cart-single-prompt hidden>Find another plant for your space</p><a class="cart-browse" href="/plants/">Continue browsing</a></div>
      </div>
      <div class="cart-checkout-wrap">
        <a class="cart-checkout" data-cart-whatsapp target="_blank" rel="noreferrer" aria-label="Enquire on WhatsApp" title="Enquire on WhatsApp"><span class="cart-enquire-label"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.5 11.6a8.5 8.5 0 0 1-12.7 7.4L3 20.5l1.5-4.6a8.5 8.5 0 1 1 16-4.3Z"/><path d="M8.5 7.8c.3-.5.6-.5.9-.5h.4l1 2.2-.7.8c.6 1.3 1.6 2.3 2.9 2.9l.8-.7 2.2 1v.4c0 .4-.1.7-.5 1-1.1.7-2.8 0-4.7-1.9S7.8 8.9 8.5 7.8Z"/></svg>Enquire</span><span data-cart-total></span></a>
        <p class="cart-checkout-note" data-cart-note hidden>Prices will be confirmed on WhatsApp</p>
      </div>
    </div>
  </main>
</BaseLayout>
<script>
  type Item = {slug:string; name:string; image:string; detail:string; price:number|null; maxPrice:number|null; estimated:boolean; example:boolean; quantity:number};
  const key = 'abdul-jabbar-cart-v1';
  const list = document.querySelector<HTMLElement>('[data-cart-items]')!;
  const total = document.querySelector<HTMLElement>('[data-cart-total]')!;
  const note = document.querySelector<HTMLElement>('[data-cart-note]')!;
  const summary = document.querySelector<HTMLElement>('[data-cart-summary]')!;
  const summaryCount = document.querySelector<HTMLElement>('[data-cart-summary-count]')!;
  const summaryTotal = document.querySelector<HTMLElement>('[data-cart-summary-total]')!;
  const singlePrompt = document.querySelector<HTMLElement>('[data-cart-single-prompt]')!;
  const whatsapp = document.querySelector<HTMLAnchorElement>('[data-cart-whatsapp]')!;
  const validIndoor = new Set<string>(JSON.parse(document.querySelector<HTMLElement>('[data-valid-indoor-slugs]')?.dataset.validIndoorSlugs || '[]'));
  let cart: Item[] = [];
  let loadFailed = false;
  try { const saved = JSON.parse(localStorage.getItem(key) || '[]'); if (Array.isArray(saved)) cart = saved.filter((x): x is Item => x && typeof x.name === 'string' && typeof x.slug === 'string' && Number.isInteger(x.quantity) && x.quantity > 0 && x.quantity <= 99 && (!x.slug.startsWith('indoor-') || validIndoor.has(x.slug))); } catch { loadFailed = true; }
  const money = (n:number) => `Rs ${new Intl.NumberFormat('en-PK').format(n)}`;
  function save() { try { localStorage.setItem(key, JSON.stringify(cart)); } catch { list.textContent = 'Your cart could not be saved.'; return; } render(); }
  function render() {
    list.replaceChildren();
    if (loadFailed) { const error = document.createElement('p'); error.className = 'cart-empty'; error.textContent = 'Your cart could not be loaded.'; list.append(error); }
    else if (!cart.length) { const empty = document.createElement('p'); empty.className = 'cart-empty'; empty.textContent = 'Your cart is empty.'; list.append(empty); }
    cart.forEach((item, index) => {
      const row = document.createElement('article'); row.className = 'cart-product';
      const imageLink = document.createElement('a'); imageLink.className = 'cart-product-image'; imageLink.href = `/plant/${encodeURIComponent(item.slug)}/`; imageLink.setAttribute('aria-label', `View ${item.name}`);
      const image = document.createElement('img'); image.src = item.image.replace('/plant-images/indoor-enhanced-', '/plant-images/indoor-white-'); image.alt = ''; image.width = 70; image.height = 80; imageLink.append(image);
      const details = document.createElement('div'); details.className = 'cart-product-details';
      const price = document.createElement('p'); price.className = 'cart-product-price'; price.textContent = item.price == null ? 'Ask for price' : `${item.estimated ? 'Est. ' : ''}${money(item.price)}${item.maxPrice ? ` to ${money(item.maxPrice)}` : ''}`;
      const name = document.createElement('h2'); name.textContent = item.name; details.append(price, name);
      if (item.detail) { const detail = document.createElement('p'); detail.className = 'cart-product-detail'; detail.textContent = item.detail; details.append(detail); }
      const remove = document.createElement('button'); remove.className = 'cart-remove'; remove.type = 'button'; remove.textContent = 'Remove'; remove.setAttribute('aria-label', `Remove ${item.name}`); remove.addEventListener('click', () => { cart.splice(index, 1); save(); }); details.append(remove);
      const right = document.createElement('div'); right.className = 'cart-product-right';
      const lineTotal = document.createElement('span'); lineTotal.className = 'cart-line-total'; lineTotal.textContent = item.price == null || item.maxPrice ? 'Price to confirm' : `${item.estimated ? 'Est. ' : ''}${money(item.price * item.quantity)}`;
      const controls = document.createElement('div'); controls.className = 'cart-quantity-control';
      const minus = document.createElement('button'); minus.type = 'button'; minus.textContent = '−'; minus.setAttribute('aria-label', `Decrease quantity for ${item.name}`); minus.disabled = item.quantity <= 1; minus.addEventListener('click', () => { item.quantity = Math.max(1, item.quantity - 1); save(); });
      const qty = document.createElement('input'); qty.className = 'cart-quantity-input'; qty.type = 'number'; qty.min = '1'; qty.max = '99'; qty.inputMode = 'numeric'; qty.value = String(item.quantity); qty.setAttribute('aria-label', `Quantity for ${item.name}`); qty.addEventListener('change', () => { item.quantity = Math.max(1, Math.min(99, Math.floor(Number(qty.value)) || 1)); save(); });
      const plus = document.createElement('button'); plus.type = 'button'; plus.textContent = '+'; plus.setAttribute('aria-label', `Increase quantity for ${item.name}`); plus.disabled = item.quantity >= 99; plus.addEventListener('click', () => { item.quantity = Math.min(99, item.quantity + 1); save(); });
      controls.append(minus, qty, plus); right.append(lineTotal, controls); row.append(imageLink, details, right); list.append(row);
    });
    const exact = cart.length > 0 && cart.every(item => item.price != null && !item.maxPrice && !item.estimated && !item.example);
    const subtotal = cart.reduce((sum, item) => sum + (item.price || 0) * item.quantity, 0);
    total.textContent = exact ? money(subtotal) : '';
    const count = cart.reduce((sum, item) => sum + item.quantity, 0);
    summary.hidden = cart.length === 0;
    singlePrompt.hidden = cart.length !== 1;
    summaryCount.textContent = `${count} ${count === 1 ? 'plant' : 'plants'}`;
    summaryTotal.textContent = exact ? money(subtotal) : 'To be confirmed';
    note.hidden = !cart.length || exact;
    const lines = cart.map(item => `${item.quantity} x ${item.name}${item.detail ? ` (${item.detail})` : ''}${item.price != null ? `, ${item.estimated ? 'estimated ' : ''}${money(item.price)}${item.maxPrice ? ` to ${money(item.maxPrice)}` : ''} each` : ', price to be confirmed'}`);
    const message = ['Hello, I would like to enquire about these plants:', '', ...lines, '', ...(exact ? [`Subtotal: ${money(subtotal)}`, ''] : []), 'Please confirm availability, prices and delivery details.'].join('\n');
    whatsapp.href = `https://wa.me/923126047941?text=${encodeURIComponent(message)}`;
    whatsapp.hidden = cart.length === 0;
  }
  render();
</script>
