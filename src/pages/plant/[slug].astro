---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PlantCard from '../../components/PlantCard.astro';
import { categoryFor, plants, plantsFor, priceLabel } from '../../data/catalog';

export function getStaticPaths() {
  return plants.map((plant) => ({ params: { slug: plant.slug }, props: { plant } }));
}

const { plant } = Astro.props;
const category = categoryFor(plant.category)!;
const related = plantsFor(plant.category).filter((item) => item.slug !== plant.slug).slice(0, 4);
const photos = plant.photoVariants ?? [plant.image, ...(plant.originalImage ? [plant.originalImage] : []), ...(plant.additionalImages ?? [])].map((image) => ({ image, detail: plant.detail, price: plant.price }));
const hasGallery = photos.length > 1;
const message = encodeURIComponent(`Hello, I am interested in ${plant.name}${photos[0].detail ? ` (${photos[0].detail})` : ''}. Please share the current availability, size and price.`);
---

<BaseLayout title={`${plant.name} | Abdul Jabbar Nursery Farm`} description={`${plant.name}${plant.detail ? `, ${plant.detail}` : ''}. Contact Abdul Jabbar Nursery Farm in Pattoki for availability and current prices.`} image={plant.image} noindex={plant.example}>
  <main id="main" class="section-wrap">
    <div class:list={['product-page', { 'has-gallery': hasGallery }]}>
      <div class:list={['product-image', { 'has-original': hasGallery }]}>
        <div class="product-gallery-track" data-gallery-track tabindex={hasGallery ? '0' : undefined} role={hasGallery ? 'region' : undefined} aria-label={hasGallery ? `Photos of ${plant.name}` : undefined}>
        {photos.map((photo, index) => <picture data-photo-price={photo.price == null ? 'Ask for price' : `${plant.estimatedPrice ? 'Est. ' : ''}${priceLabel(photo.price, plant.maxPrice)}`} data-photo-detail={photo.detail ?? ''} data-photo-message={encodeURIComponent(`Hello, I am interested in ${plant.name}${photo.detail ? ` (${photo.detail})` : ''}. Please share the current availability, size and price.`)}>
          <source media="(max-width: 700px)" srcset={photo.image.replace('/plant-images/', '/plant-images/optimized/')} />
          <img src={photo.image} alt={`${plant.name}${index ? ` photo ${index + 1}` : ''}`} width="840" height="1260" fetchpriority={index === 0 ? 'high' : undefined} loading={index === 0 ? 'eager' : 'lazy'} decoding="async" />
        </picture>)}
        </div>
        {hasGallery && <div class="product-gallery-controls" role="group" aria-label="Choose a photo">
          {photos.map((_, index) => <button type="button" data-gallery-page={index} aria-label={`Show photo ${index + 1}`} aria-pressed={index === 0 ? 'true' : 'false'}></button>)}
        </div>}
      </div>
      <article class="product-info">
        <a class="product-category" href={`/plants/${category.slug}/`}>{category.title}</a>
        <h1>{plant.name}</h1>
        <p class="product-price" data-gallery-price aria-live="polite">{plant.price == null ? 'Ask for price' : `${plant.estimatedPrice ? 'Est. ' : ''}${priceLabel(plant.price, plant.maxPrice)}`}</p>
        {(plant.detail || plant.photoVariants) && <p data-gallery-detail aria-live="polite">{photos[0].detail}</p>}
        {plant.estimatedPrice && <p>Contact the nursery to confirm the current price.</p>}
        <div class="product-actions">
          <a class="button button-dark" data-gallery-enquiry href={`https://wa.me/923126047941?text=${message}`} target="_blank" rel="noreferrer"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.5 11.6a8.5 8.5 0 0 1-12.7 7.4L3 20.5l1.5-4.6a8.5 8.5 0 1 1 16-4.3Z"/><path d="M8.5 7.8c.3-.5.6-.5.9-.5h.4l1 2.2-.7.8c.6 1.3 1.6 2.3 2.9 2.9l.8-.7 2.2 1v.4c0 .4-.1.7-.5 1-1.1.7-2.8 0-4.7-1.9S7.8 8.9 8.5 7.8Z"/></svg><span>Ask about this plant</span></a>
          <a class="button product-call" href="tel:+923126047941"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.9v2.8a2 2 0 0 1-2.2 2A19.7 19.7 0 0 1 2.3 4.2a2 2 0 0 1 2-2.2h2.8a2 2 0 0 1 2 1.7l.4 2.6a2 2 0 0 1-.6 1.8L7.7 9.3a16 16 0 0 0 7 7l1.2-1.2a2 2 0 0 1 1.8-.6l2.6.4a2 2 0 0 1 1.7 2Z"/></svg><span>Call the nursery</span></a>
        </div>
      </article>
    </div>
    <section class="related" aria-labelledby="related-title">
      <div class="related-heading">
        <h2 id="related-title">More in {category.title}</h2>
        <a class="text-link" href={`/plants/${category.slug}/`}>View the collection</a>
      </div>
      <div class="plant-grid">
        {related.map((item) => <PlantCard plant={item} />)}
      </div>
    </section>
  </main>
</BaseLayout>

<script>
  const track = document.querySelector<HTMLElement>('[data-gallery-track]');
  const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-gallery-page]'));
  if (track && buttons.length) {
    buttons.forEach((button, index) => button.addEventListener('click', () => {
      track.scrollTo({ left: index * track.clientWidth, behavior: 'auto' });
    }));
    track.addEventListener('scroll', () => {
      const active = Math.round(track.scrollLeft / track.clientWidth);
      buttons.forEach((button, index) => button.setAttribute('aria-pressed', String(index === active)));
      const photo = track.children[active] as HTMLElement | undefined;
      const price = document.querySelector<HTMLElement>('[data-gallery-price]');
      const detail = document.querySelector<HTMLElement>('[data-gallery-detail]');
      const enquiry = document.querySelector<HTMLAnchorElement>('[data-gallery-enquiry]');
      if (photo && price && photo.dataset.photoPrice) price.textContent = photo.dataset.photoPrice;
      if (photo && detail) detail.textContent = photo.dataset.photoDetail ?? '';
      if (photo && enquiry && photo.dataset.photoMessage) enquiry.href = `https://wa.me/923126047941?text=${photo.dataset.photoMessage}`;
    }, { passive: true });
  }
</script>
